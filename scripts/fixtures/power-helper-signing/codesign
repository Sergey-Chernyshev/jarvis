#!/usr/bin/env bash
set -euo pipefail

: "${JARVIS_TEST_TOOL_LOG:?}"
printf 'codesign %s\n' "$*" >>"$JARVIS_TEST_TOOL_LOG"

if [[ " $* " == *" --force "* && "${MOCK_CODESIGN_MODE:-valid}" == "sign-fail" ]]; then
  exit 1
fi

if [[ " $* " == *" --display "* || " $* " == *" -d "* ]]; then
  team_id="${MOCK_CODESIGN_TEAM_ID:-ABCDEFGHIJ}"
  cat >&2 <<EOF
Executable=/mock/jarvis-power-helper
Identifier=app.jarvis.monitor.power-helper
Authority=Developer ID Application: Jarvis Test ($team_id)
Authority=Developer ID Certification Authority
Authority=Apple Root CA
TeamIdentifier=$team_id
Signature size=9000
designated => identifier "app.jarvis.monitor.power-helper" and anchor apple generic and certificate leaf[subject.OU] = "$team_id" and certificate 1[field.1.2.840.113635.100.6.2.6] exists and certificate leaf[field.1.2.840.113635.100.6.1.13] exists
EOF
fi
