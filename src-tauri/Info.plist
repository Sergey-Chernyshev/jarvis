<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Jarvis живёт в меню-баре. Без LSUIElement приложение стартует как
         обычное (док + активация + подмена строки меню) и опускается до
         Accessory только внутри setup() — после миграции настроек и Daemon::new.
         На каждом логине это выглядело как вспышка чужой иконки в доке.
         Оконный режим поднимает политику обратно до Regular в рантайме
         (main.rs / windows::apply_mode) — иконка в доке там появляется. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Микрофон (инкр. 9, §10): обязательное описание для App Store / notarization.
         macOS показывает эту строку в системном диалоге разрешения микрофона при
         первой попытке захвата аудио через диктовку Jarvis. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Jarvis использует микрофон для голосовой диктовки.</string>
</dict>
</plist>
