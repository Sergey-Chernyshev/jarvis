{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agent-chat",
  "description": "Trusted Jarvis agent chat with exact app-command grants",
  "local": true,
  "webviews": ["agent-chat"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-agent-confirm",
    "allow-agent-send"
  ]
}
