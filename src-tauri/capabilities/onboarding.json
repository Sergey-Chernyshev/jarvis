{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "Trusted Jarvis onboarding surface with exact app-command grants",
  "webviews": ["onboarding"],
  "permissions": [
    "core:event:allow-listen",
    "allow-settings-repair",
    "allow-app-relaunch",
    "allow-onboarding-get",
    "allow-onboarding-run",
    "allow-onboarding-close",
    "allow-onboarding-open-panel",
    "allow-onboarding-open-settings",
    "allow-models-install"
  ]
}
