{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.3.3",
  "identifier": "app.jarvis.monitor",
  "build": {
    "beforeBuildCommand": "npm run build:core-transport && npm run prepare:agent-vm-sidecar",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "freezePrototype": true,
      "capabilities": ["main", "toast", "onboarding", "agent-chat"],
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sergey-Chernyshev/jarvis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNzk2RTREOUY5M0RDQQpSV1RLUGZuWjVKYjNCdUNjQ3NjYVZ2NjZveTVtdloxb3lzNlVhTlNnenZrN2x4NC9tTFgwb213Ugo="
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "© 2026 Jarvis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/jarvis-agent-vm-plugin"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  }
}
